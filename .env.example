# ==============================================================================
# Instagram MCP Server - Environment Configuration Template
# Copy this file to .env and fill in your credentials.
# NEVER commit your real .env file or credentials to version control.
# ==============================================================================

# Meta Developer App Credentials (from https://developers.facebook.com/apps/)
META_APP_ID=your_meta_app_id_here
META_APP_SECRET=your_meta_app_secret_here

# Instagram Account Information (from Meta Developer App > Instagram Login)
INSTAGRAM_USER_ID=your_instagram_user_id_here
INSTAGRAM_ACCESS_TOKEN=your_long_lived_instagram_access_token_here

# Meta Graph API Version (Default: v21.0)
META_API_VERSION=v21.0

# HTTP Helper Server Port (for OAuth callbacks and incoming Meta Webhooks)
PORT=3000

# Meta Webhook Verification Token (Configure the same token in Meta App Dashboard > Webhooks)
WEBHOOK_VERIFY_TOKEN=your_secure_random_webhook_verify_token_here

# OAuth Redirect URI (Configured in Meta App Dashboard > Instagram Login > Settings)
# For local development: http://localhost:3000/oauth/callback
# For production: https://your-domain.com/oauth/callback
INSTAGRAM_REDIRECT_URI=http://localhost:3000/oauth/callback

# Persistent SQLite Database Location
DATABASE_PATH=./data/scheduler.db

# Optional Admin Key to protect remote /oauth/refresh endpoint
# ADMIN_API_KEY=your_secure_admin_key_here

# Optional AI Providers for generate_caption tool
# If omitted, server automatically uses built-in AI Caption Studio engine
# OPENAI_API_KEY=your_openai_api_key_here
# GEMINI_API_KEY=your_gemini_api_key_here
